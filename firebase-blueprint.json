{
  "entities": {
    "case": {
      "title": "Success Case",
      "description": "Information about a success case study",
      "type": "object",
      "properties": {
        "title": { "type": "string", "description": "Case title" },
        "blogUrl": { "type": "string", "description": "Link to the blog post" },
        "pdfUrl": { "type": "string", "description": "Link to the PDF file (One Page)" },
        "pngUrl": { "type": "string", "description": "Link to the PNG file" },
        "tags": { "type": "array", "description": "List of tags associated with the case" },
        "content": { "type": "string", "description": "Extracted content from the blog for re-indexing" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "authorId": { "type": "string" }
      },
      "required": ["title", "blogUrl", "tags"]
    },
    "user": {
      "title": "Authorized User",
      "description": "User profile and permissions",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "role": { "type": "string", "enum": ["admin", "viewer"] },
        "name": { "type": "string" }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "cases": {
      "schema": "case",
      "description": "Collection of company success cases"
    },
    "authorized_users": {
      "schema": "user",
      "description": "List of emails allowed to log in and their roles"
    }
  }
}

rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower())).data;
    }

    function isAuthorized() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'ana.pmartins@dati.com.br' ||
        exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower()))
      );
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email.lower() == 'ana.pmartins@dati.com.br' ||
        (exists(/databases/$(database)/documents/authorized_users/$(request.auth.token.email.lower())) && 
         getUserData().role == 'admin')
      );
    }

    function isValidCase(data) {
      return data.get('title', '') is string && data.get('title', '').size() > 0 && data.get('title', '').size() <= 200 &&
             data.get('blogUrl', '') is string && data.get('blogUrl', '').size() > 0 &&
             data.get('tags', []) is list && data.get('tags', []).size() <= 50;
    }

    // Collection Security
    match /authorized_users/{email} {
      // Users can read their own authorization info to determine role
      // We check against lowercase to be safe
      allow get: if isSignedIn() && request.auth.token.email.lower() == email;
      // Only admins can manage the authorized users list
      allow list, write: if isAdmin();
    }

    match /cases/{caseId} {
      allow read: if isAuthorized();
      
      allow create: if isAdmin() && isValidCase(request.resource.data) &&
                      request.resource.data.createdAt == request.time;
      
      allow update: if isAdmin() && isValidCase(request.resource.data) &&
                      request.resource.data.updatedAt == request.time;
                      
      allow delete: if isAdmin();
    }
  }
}
